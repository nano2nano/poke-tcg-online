{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "es2024": true
  },
  "ignorePatterns": ["engine/**", "dist/**", "web/routeTree.gen.ts"],
  "rules": {
    // JSX の変換は React を import しなくてよい形（tsconfig の `jsx: "react-jsx"`）。
    "react/react-in-jsx-scope": "off",
    // `toSorted` と `toReversed` は ES2023 で、tsconfig の lib は ES2022 に留めている。
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // `__ENGINE_COMMIT__` などビルドで埋める定数の名前に当たる。
    "no-underscore-dangle": "off",
    // 使う場所の近くに置いた小さな関数まで外へ出させると、読む場所が離れる。
    "unicorn/consistent-function-scoping": "off",
    // テストは Worker とのやり取りを 1 つずつ順に確かめる。並べると確かめたい順番が崩れる。
    "no-await-in-loop": "off",
    // 画面の状態は書き換えずに作り直す。広げて作り直す書き方をこのルールは直させる。
    "oxc/no-map-spread": "off",
    // 分岐を網羅したかは tsc が戻り値の型で確かめる。このルールは網羅した switch も指摘する。
    "typescript/consistent-return": "off",
    // 次へ値を渡さない `then` にも return を書かせる。ここでは Promise の鎖を長くつながない。
    "promise/always-return": "off",
    "react/rules-of-hooks": "error",
    // union に種類が増えたとき、扱いを決めていない switch を見つける。残りを捨てる switch は `default` で書く。
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "typescript/no-misused-promises": "error",
    // 表示名は符号位置の単位で切る（`src/accounts.ts`）。文字列を広げるのはそのため。
    "typescript/no-misused-spread": ["error", { "allow": [{ "from": "lib", "name": "string" }] }],
    // Vitest の `expect` は 2 つ目に落ちたときのメッセージを取る。
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // テストは型を絞る `if` の中で確かめる。種類そのものは `if` の前か、通った件数で確かめている。
    "vitest/no-conditional-expect": "off",
    // `noUncheckedIndexedAccess` で付いた `undefined` を、あると分かっている箇所で外す `as` まで拾う。
    // 外から届く値は `src/protocol.ts` と `src/requests.ts` の Zod で検めてから使う。
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": true }]
  },
  "overrides": [
    {
      // Playwright の fixture の `use` を React の hook と取り違える。
      "files": ["e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    }
  ]
}

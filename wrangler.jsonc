// Cloudflare に出すときの設定（`docs/deploy.md`）。無料プランの範囲で動く形にしてある。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poke-tcg-online",
  // ビルドは `vite build` が行い、`wrangler deploy` はその出力（`dist/server/wrangler.json`）を読む。
  // ビルドせずに `wrangler deploy` を直に呼ぶと、前にビルドした古い Worker が出る。出すのは `npm run deploy` から。
  "main": "web/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 画面は静的アセットで返し、Worker を先に通すのは API と WebSocket だけにする。画面の配信は Worker の要求に数えられない。
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*", "/ws"],
  },
  "durable_objects": {
    "bindings": [{ "name": "SERVER", "class_name": "Server" }],
  },
  // 無料プランで使える Durable Object は SQLite 型だけである。この Durable Object 自身は保存を持たない。
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Server"] }],
  // ID を書かなければ、初めての `wrangler deploy` が作る。
  "d1_databases": [{ "binding": "DB", "database_name": "poke-tcg-online" }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "poke-tcg-online-matches" }],
  "observability": { "enabled": true },
  // 公式のカード画像を出す（仕様 3.7 節）。`off` にすると、画面は名前と種類の面で描く。
  "vars": { "CARD_IMAGES": "official" },
}
